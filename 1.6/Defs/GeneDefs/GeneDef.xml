<GeneDef>
<defName>Unbreakable</defName>
<label>unbreakable</label>
<description>Carriers very rarely experience mental breakdowns. They are virtually unaffected by severe trauma, and are eerily numb to everything shy of months of psychological torture.</description>
     <iconPath>UI/Genes/Unbreakable</iconPath>      
        <statOffsets>
          <MentalBreakThreshold>-0.36</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.15</CertaintyLossFactor>
        </statFactors>
</GeneDef>

<GeneDef>
<defName>Efficient</defName>
<label>efficient</label>
<description>Carriers are industrious in every way. They seem to know how to get everything done as quickly, cheaply, and effectively as possible.</description>
    <iconPath>UI/Genes/Efficient</iconPath>  
      <statOffsets>
          <WorkSpeedGlobal>0.35</WorkSpeedGlobal>
        </statOffsets>
</GeneDef>

  <GeneDef>
    <defName>Sadistic</defName>
    <label>sadistic</label>
    <description>Due to overactive predatory and competitive instincts, carriers of this gene seem to just love watching things bleed. Their nature can be disciplined or completely suppressed with enough effort, but it is something to keep in mind.</description>
    <displayOrderInCategory>20</displayOrderInCategory>
    <iconPath>UI/Genes/Sadistic</iconPath>
    <forcedTraits>
      <li>
        <def>Bloodlust</def>
      </li>
    </forcedTraits>
 </GeneDef>

    <GeneDef ParentName="LahlitBloodColor">
        <defName>BlackBlood</defName>
        <label>black blood</label>
        <description>Due to either improper modification of this species' genome, freak mutation from an unknown or simply overlooked environmental variable, or a combination of the two, this species bleeds an oily, viscous, ichorous substance as black as pitch.</description>
        <iconPath>UI/Genes/BlackBlood</iconPath>
        <displayOrderInCategory>4</displayOrderInCategory>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <customBloodThingDef>Blood_Filth_Black</customBloodThingDef>
                <customBloodIcon></customBloodIcon>
                <customBloodEffect>Damage_Black</customBloodEffect>
                <customWoundsFromFleshtype>FleshType_Black</customWoundsFromFleshtype>
                <customBloodSmearThingDef>Filth_Lahlit_BloodSmear</customBloodSmearThingDef>
            </li>
        </modExtensions>
    </GeneDef>

