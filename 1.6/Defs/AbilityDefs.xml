  <Defs>
  <AbilityDef>
    <defName>Rally</defName>
    <label>rally</label>
    <description>Rrathekk! Rouse your comrades to fight against odds some may say are unbeatable-but you know better. Buffs any pawn within its AoE for 12 hours.</description>
    <targetRequired>False</targetRequired>
    <jobDef>CastAbilityOnThing</jobDef>
    <groupDef>Leader</groupDef>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <cooldownTicksRange>240000</cooldownTicksRange>
    <iconPath>UI/Abilities/Rally</iconPath>
    <hotKey>Misc1</hotKey>
    <aiCanUse>true</aiCanUse>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_Duration>1000</Ability_Duration>
      <Ability_EffectRadius>1.9</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.25</warmupTime>
      <range>1.9</range>
      <drawAimPie>False</drawAimPie>
      <requireLineOfSight>False</requireLineOfSight>
      <soundCast>Pawn_Mech_Termite_Call</soundCast>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class = "CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>Rallied</hediffDef>
        <applicableToMechs>False</applicableToMechs>
        <onlyBrain>True</onlyBrain>
        <replaceExisting>true</replaceExisting>
      </li>
    </comps>
  </AbilityDef>
  </Defs>